# Copy this file to .env when running the root docker-compose.yml locally.
# Keep .env local and never commit real cloud credentials or private-key paths.

# Keeps Docker network names stable for the migration container.
COMPOSE_PROJECT_NAME=shopizer

# Local MySQL credentials used by the Dockerized Shopizer database.
MYSQL_ROOT_PASSWORD=root_dev_pass
MYSQL_USER=shopizer
MYSQL_PASSWORD=shopizer_dev_pass

# Local Shopizer admin credentials used by setup_catalog.py and Gatling setup.
SHOPIZER_ADMIN_EMAIL=admin@shopizer.com
SHOPIZER_ADMIN_PASS=password

# BigQuery project used by the Shopizer app when BigQuery tracing is enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Host path to the Snowflake private key mounted into Shopizer and the Python services.
SNOWFLAKE_PRIVATE_KEY_MOUNT_SOURCE=./secrets/ecomm_sf_key.p8

# Optional Gatling overrides.
GATLING_SIMULATION_CLASS=simulations.UserActivitySimulation
GATLING_ACTIVITY_USERS=600
GATLING_SESSION_DURATION_SECONDS=21600
GATLING_RAMP_SECONDS=300
GATLING_BASE_URL=http://sm-shop:8081
GATLING_STORE_CODE=DEFAULT
GATLING_LANG=en
