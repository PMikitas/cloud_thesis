# Copy this file to .env and replace the placeholder values.
# Never commit .env, private keys, service-account JSON, or real cloud passwords.

# Source database used by the migration container.
MYSQL_DSN=mysql+pymysql://shopizer_user:replace-me@shopizer-db:3306/SALESMANAGER

# Cron-driven operational table refresh.
MIGRATION_CRON=*/3 * * * *
MIGRATION_DESTINATIONS=bigquery,snowflake
MIGRATION_NAMESPACE=performance_tracking
MIGRATION_WRITE_DISPOSITION=merge
MIGRATION_INCREMENTAL_ENABLED=true
MIGRATION_RESET_PIPELINE_STATE=false
MIGRATION_DROP_DESTINATION_TABLES_ON_REPLACE=false
# MIGRATION_TABLES=CUSTOMER,PRODUCT,PRODUCT_AVAILABILITY,PRODUCT_DESCRIPTION,PRODUCT_PRICE,SHOPPING_CART,SHOPPING_CART_ITEM
MIGRATION_TZ=UTC
RUN_ONCE_ON_START=false
LOG_LEVEL=INFO

# BigQuery destination.
# The compose file mounts your local ADC directory to this in-container path.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcloud/application_default_credentials.json
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=performance_tracking
# BQ_PIPELINE_NAME=shopizer_mysql_to_bigquery

# Snowflake destination.
SNOWFLAKE_DATABASE=YOUR_SNOWFLAKE_DATABASE
SNOWFLAKE_USERNAME=YOUR_SNOWFLAKE_USER
SNOWFLAKE_HOST=your-account.region.cloud
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_ROLE=YOUR_ROLE
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake/ecomm_sf_key.p8
# SNOWFLAKE_PRIVATE_KEY=replace-with-inline-key-only-if-you-do-not-mount-a-key-file
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace-me-if-your-key-is-encrypted
SF_SCHEMA=performance_tracking
# SF_PIPELINE_NAME=shopizer_mysql_to_snowflake

# Redshift destination. Required only when MIGRATION_DESTINATIONS includes redshift.
REDSHIFT_DATABASE=dev
REDSHIFT_USERNAME=YOUR_REDSHIFT_USER
REDSHIFT_PASSWORD=YOUR_REDSHIFT_PASSWORD
REDSHIFT_HOST=your-redshift-endpoint.region.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_CONNECT_TIMEOUT=15
RS_SCHEMA=public
# RS_PIPELINE_NAME=shopizer_mysql_to_redshift

# Local Docker wiring.
SHOPIZER_NETWORK_NAME=shopizer_default
SNOWFLAKE_PRIVATE_KEY_MOUNT_SOURCE=/absolute/path/to/ecomm_sf_key.p8
