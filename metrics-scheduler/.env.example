# Copy this file to .env and replace the placeholder values.
# Never commit .env, private keys, service-account JSON, or real cloud passwords.

LOG_LEVEL=INFO

# Warehouse selection comes from ../tracing.env by default.
# Optional metrics-only override: snowflake, redshift, bigquery, or comma-separated.
# METRICS_WAREHOUSES=snowflake

# Snowflake event table used by the behavioral/API tracing metrics.
METRICS_SNOWFLAKE_EVENT_TABLE=API_TRACKING
METRICS_SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
METRICS_BIGQUERY_EVENT_TABLE=api_tracking

# Redshift connection/retry behavior for benchmark runs.
METRICS_REDSHIFT_CONNECT_TIMEOUT_SECONDS=20
METRICS_REDSHIFT_CONNECT_ATTEMPTS=3
METRICS_REDSHIFT_RETRY_DELAY_SECONDS=5
METRICS_REDSHIFT_DISABLE_RESULT_CACHE=true

# Scheduler cadence for the metric groups in run_metrics.py.
METRICS_OPERATIONAL_CRON=*/5 * * * *
METRICS_BUSINESS_CRON=*/15 * * * *
METRICS_BEHAVIORAL_CRON=*/20 * * * *
METRICS_DAILY_REPORTING_CRON=*/30 * * * *

# BigQuery project for benchmark queries.
# The compose file mounts ../secrets/ecomm_sf_key/gcp/bigquery-service-account.json
# to GOOGLE_APPLICATION_CREDENTIALS inside the metrics container.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp/bigquery-service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCLOUD_PROJECT=your-gcp-project-id
BQ_PROJECT_ID=your-gcp-project-id

# Optional local overrides.
# METRICS_SQL_FILE=/workspace/metrics_scripts.sql
# METRICS_OUTPUT_DIR=/app/results
# SHOPIZER_REPO_ROOT=/workspace

# The metrics scheduler also reads warehouse credentials from:
# - data-migration-scripts/.env
# - sm-shop/src/main/resources/snowflake.properties
# - sm-shop/src/main/resources/redshift.properties
# Keep those files local and untracked.
SNOWFLAKE_PRIVATE_KEY_MOUNT_SOURCE=/absolute/path/to/ecomm_sf_key_api_user1.p8
